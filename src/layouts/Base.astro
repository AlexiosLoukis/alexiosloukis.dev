---
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f151d" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ── Light (default) ─────────────────────────────── */
  :root {
    --paper: #fbfbfd;
    --raised: #f2f3f7;
    --ink: #16202e;
    --ink-soft: #545f6e;
    --rule: #e2e5ec;
    --signal: #2d6ba8;
    --live: #16704f;
    --progress: #8f5a12;
    --queued: #67707e;

    --display: "Space Grotesk", system-ui, sans-serif;
    --body: "IBM Plex Sans", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
  }

  /* ── Dark, when the OS asks for it ───────────────── */
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0f151d;
      --raised: #161e28;
      --ink: #e6eaf0;
      --ink-soft: #97a2b2;
      --rule: #263040;
      --signal: #79b1e8;
      --live: #4dc79a;
      --progress: #e0a458;
      --queued: #8f9aab;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--signal);
    color: var(--paper);
  }

  main {
    max-width: 46rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 6rem;
  }

  @media (max-width: 40rem) {
    main {
      padding-top: 3rem;
    }
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  h1 {
    font-size: clamp(2.25rem, 7vw, 3.25rem);
    font-weight: 700;
  }

  h2 {
    font-size: 0.8125rem;
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.75rem;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  p {
    margin: 0 0 1.1rem;
  }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--raised);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  a {
    color: var(--signal);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 150ms ease, text-underline-offset 150ms ease;
  }

  a:hover {
    color: var(--ink);
    text-underline-offset: 5px;
  }

  a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: 2px;
  }

  section {
    margin-top: 4rem;
  }

  /* ── hero ────────────────────────────────────────── */

  .tagline {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 0.9rem 0 2rem;
  }

  .lede {
    font-size: 1.1875rem;
    max-width: 36rem;
  }

  /* ── status board ────────────────────────────────── */

  .status {
    border-top: 1px solid var(--rule);
  }

  .status-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.5rem 1.25rem;
    padding: 0.95rem 0.75rem;
    margin: 0 -0.75rem;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
    border-radius: 4px;
    transition: background-color 200ms ease;
  }

  .status-row:hover {
    background: var(--raised);
  }

  @media (max-width: 34rem) {
    .status-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    white-space: nowrap;
  }

  .tag::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    margin-right: 0.5rem;
    vertical-align: 0.05em;
    background: currentColor;
  }

  .tag-live {
    color: var(--live);
  }

  /* the one live signal on the page — a slow, quiet pulse */
  .tag-live::before {
    box-shadow: 0 0 0 0 currentColor;
    animation: pulse 3.5s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 55%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }

  .tag-progress {
    color: var(--progress);
  }
  .tag-queued {
    color: var(--queued);
  }

  .stack {
    font-size: 0.9375rem;
  }

  .note {
    display: block;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }

  /* ── project entries ─────────────────────────────── */

  .entry {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .entry:last-child {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .entry-tech {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin-bottom: 0.75rem;
  }

  .entry p {
    margin-bottom: 0.6rem;
    max-width: 38rem;
  }

  /* ── background list ─────────────────────────────── */

  .record {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0.25rem 1.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (max-width: 34rem) {
    .record {
      grid-template-columns: 1fr;
    }
  }

  .record:last-child {
    border-bottom: 0;
  }

  .when {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    padding-top: 0.3rem;
  }

  .where {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 0.1rem 0 0;
  }

  /* ── contact ─────────────────────────────────────── */

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-family: var(--mono);
    font-size: 0.9375rem;
  }

  footer {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
